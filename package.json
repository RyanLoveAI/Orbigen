{
  "name": "orbigen",
  "version": "1.57.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "test": "node --experimental-loader ./tests/three-loader.mjs --test tests/*.test.mjs",
    "test:vegetation": "node --experimental-loader ./tests/three-loader.mjs tests/vegetation-generator.check.mjs",
    "test:tree-review": "node --experimental-loader ./tests/three-loader.mjs --test tests/tree-review.test.mjs",
    "test:tree-review:http": "node --experimental-loader ./tests/three-loader.mjs scripts/check-tree-review-http.mjs",
    "build:tree-review": "node scripts/sync-tree-review-worker.mjs"
  },
  "engines": {
    "node": ">=24"
